# ---- OpenAI ----
OPENAI_API_KEY=sk-...
AGENT_MODEL=gpt-5.6-terra
ROUTER_MODEL=gpt-5.6-luna
EMBED_MODEL=text-embedding-3-large
EMBED_DIM=3072
# set to -1 to omit `temperature` (some reasoning tiers reject it)
AGENT_TEMPERATURE=0.3

# ---- Pinecone ---- (create index: dim=3072, metric=cosine)
PINECONE_API_KEY=pc-...
PINECONE_INDEX=engosoft-courses
PINECONE_NAMESPACE=prod

# ---- Odoo 17 (values live in your engosoft-n8n skill) ----
ODOO_URL=https://engosoft.com
ODOO_DB=EngoSoft
ODOO_UID=15577
ODOO_API_KEY=__PUT_YOUR_ODOO_API_KEY_HERE__
ODOO_COURSE_MODEL=product.template
SALES_ADVISOR_ID=2

# ---- Checkout / Chatwoot ----
SHOP_BASE=https://engosoft.com
CHATWOOT_URL=https://chat.engosoft.com
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_INBOX_ID=1
CHATWOOT_API_TOKEN=

# ---- State ----
# Leave DATABASE_URL empty for in-memory memory (dev only — dies on restart).
DATABASE_URL=postgresql://engo:engo@postgres:5432/engo_advisor
# >= 32 random bytes, e.g. `openssl rand -hex 32`
JWT_SECRET=__long_random__
JWT_TTL_HOURS=12
GUEST_RATE_PER_MIN=20
GUEST_MINT_PER_HOUR=30

# ---- CORS ---- (comma separated; defaults to SHOP_BASE)
CORS_ORIGINS=https://engosoft.com,https://demo.engosoft.com
