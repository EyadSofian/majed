# ---- OpenAI ----
OPENAI_API_KEY=sk-...
AGENT_MODEL=gpt-5.6-terra
ROUTER_MODEL=gpt-5.6-luna
# set to -1 to omit `temperature` (some reasoning tiers reject it)
AGENT_TEMPERATURE=0.3
# Arabic profile fallback: translates bio/title/experience when Odoo has no
# Arabic value. It uses ROUTER_MODEL and caches each source profile in-process.
PROFILE_TRANSLATION_ENABLED=true
PROFILE_TRANSLATION_TIMEOUT=12
PROFILE_TRANSLATION_CACHE_SIZE=256

# ---- Odoo 17 ----
ODOO_URL=https://engosoft.com
ODOO_DB=EngoSoft
ODOO_UID=15577
ODOO_API_KEY=__PUT_YOUR_ODOO_API_KEY_HERE__
# Courses are product.template rows of this custom type
COURSE_PRODUCT_TYPE=course
SALES_ADVISOR_ID=2

# ---- Catalogue cache ----
CATALOG_REFRESH_SECONDS=300
EVENTS_HORIZON_DAYS=240

# ---- Pricing ---- (website-linked pricelist ids, per currency)
PRICELIST_EGP=28
PRICELIST_USD=27
PRICELIST_AED=29
PRICELIST_SAR=9
DEFAULT_CURRENCY=EGP

# ---- Checkout ----
SHOP_BASE=https://engosoft.com

# ---- State ----
# Leave empty for in-memory memory (dev only — dies on restart).
DATABASE_URL=postgresql://engo:engo@postgres:5432/engo_advisor
# >= 32 random bytes, e.g. `openssl rand -hex 32`
JWT_SECRET=__long_random__
JWT_TTL_HOURS=12
GUEST_RATE_PER_MIN=20
GUEST_MINT_PER_HOUR=30

# ---- CORS ---- (comma separated; defaults to SHOP_BASE)
CORS_ORIGINS=https://engosoft.com,https://demo.engosoft.com

# ---- Package ingest (n8n pushes the training.package snapshot here) ----
# openssl rand -hex 32 ; the same value goes into the n8n workflow header.
INGEST_TOKEN=
# Production URL of packages_on_demand.n8n.json after activation, for example:
# https://n8n.example.com/webhook/engosoft/packages
PACKAGES_WEBHOOK_URL=
PACKAGES_MAX_AGE_SECONDS=600
PACKAGES_FETCH_TIMEOUT=12

# ---- Trial on demo.engosoft.com ----
# false => create_lead is simulated instead of writing to the live CRM.
ALLOW_CRM_WRITES=true

# ---- Deep course details: who answers "تفاصيل أكتر" ----
# false (default): Nabras answers with get_course_details — fully working today.
# true: Nabras defers to Botpress (defer_to_bot "course_details") so Botpress
#       answers with the full syllabus, link and reviews. Only turn on once
#       Botpress is set up to answer course-detail questions.
DETAILS_TO_BOTPRESS=false

# ---- Lead follow-up (the sales SLA) ----
# Every captured lead gets a dated mail.activity, so it appears in the advisor's
# "Activity Today" and ages into "Overdue" like a human-captured lead. Without
# one it sits in no queue and nobody is ever late on it.
LEAD_ACTIVITY_ENABLED=true
LEAD_ACTIVITY_DAYS=0
LEAD_ACTIVITY_SUMMARY=متابعة عميل جديد من ماجد
# utm.source on the lead, so "how many came from Majed?" is a CRM filter next to
# Unpaid / AbanteCart / Signup. Empty disables the lookup.
LEAD_SOURCE_NAME=ماجد
