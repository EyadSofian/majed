    },
    {
      "parameters": {
        "jsCode": "// Assemble the snapshot نبراس expects. Each Odoo node is read by name so\n// the merge mode is irrelevant and one denied model does not lose the rest.\nfunction pull(node) {\n  try {\n    const rows = $(node).all().map((i) => i.json).filter((r) => r && r.id);\n    return rows;\n  } catch (e) {\n    console.log('pull failed for ' + node + ': ' + e);\n    return [];\n  }\n}\n\n// Only what a customer could actually be sold.\nconst packages = pull('Odoo — Packages')\n  .filter((p) => p.website_published && p.active !== false);\nconst pkgIds = new Set(packages.map((p) => p.id));\nconst ofPkg = (rows) => rows.filter(\n  (r) => Array.isArray(r.package_id) && pkgIds.has(r.package_id[0]));\n\nconst payload = {\n  packages,\n  levels:         ofPkg(pull('Odoo — Levels')),\n  lines:          ofPkg(pull('Odoo — Recorded Lines')).filter((l) => l.website_published),\n  attendee_lines: ofPkg(pull('Odoo — Attendee Lines')),\n  groups:         ofPkg(pull('Odoo — Groups')),\n  outcomes:       pull('Odoo — Outcomes'),\n};\n\nif (!payload.packages.length) {\n  throw new Error('No published packages returned — refusing to push an empty snapshot.');\n}\n\n// website_url is relative on this model; نبراس wants it absolute.\nfor (const p of payload.packages) {\n  p.url = p.website_url && !String(p.website_url).startsWith('http')\n    ? 'https://engosoft.com' + p.website_url\n    : p.website_url;\n}\n\nconst counts = Object.fromEntries(\n  Object.entries(payload).map(([k, v]) => [k, v.length]));\nconsole.log('pushing', JSON.stringify(counts));\nreturn [{ json: { payload, counts } }];"
      },
      "id": "b7c1a000-0010-4a10-9b01-000000000010",
      "name": "Build Snapshot",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').item.json.NABRAS_URL }}/api/v1/internal/catalog/packages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Ingest-Token",
              "value": "={{ $('Config').item.json.INGEST_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.payload) }}",
        "options": {
          "timeout": 30000
        }
      },
